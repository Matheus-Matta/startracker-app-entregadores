# Copie este arquivo para .env e preencha todos os valores.
# O arquivo .env nunca deve ser enviado ao Git.

# Configuracao usada pelo aplicativo
BACKEND_URL=https://tracker.star.dev.br
NOTIFICATIONS_ENABLED=true
FLEET_WEBSOCKET_PATH=/ws/mobile/fleet/
NOTIFICATIONS_WEBSOCKET_PATH=/ws/mobile/notifications/
NOTIFICATION_CHANNEL_ID=star_tracker_delivery_updates
NOTIFICATION_CHANNEL_NAME=Atualizacoes de entrega
NOTIFICATION_CHANNEL_DESCRIPTION=Novas cargas e alteracoes de pedidos e rotas

# Google Play / assinatura Android
ANDROID_KEYSTORE_BASE64=COLE_AQUI_O_UPLOAD_KEYSTORE_EM_BASE64
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=COLE_AQUI_A_SENHA_DA_CHAVE
ANDROID_STORE_PASSWORD=COLE_AQUI_A_SENHA_DO_KEYSTORE
PLAY_SERVICE_ACCOUNT_JSON_BASE64=COLE_AQUI_O_JSON_DO_GOOGLE_EM_BASE64
PLAY_TRACK=internal
PLAY_RELEASE_STATUS=completed

# App Store Connect / assinatura iOS
IOS_BUNDLE_ID=br.dev.star.tracker.entregas
IOS_PROVISIONING_PROFILE_NAME=AppStore br.dev.star.tracker.entrega
IOS_TEAM_ID=COLE_AQUI_O_TEAM_ID
APPSTORE_ISSUER_ID=COLE_AQUI_O_ISSUER_ID
APPSTORE_API_KEY_ID=COLE_AQUI_O_KEY_ID
APPSTORE_API_PRIVATE_KEY_BASE64=COLE_AQUI_O_ARQUIVO_P8_EM_BASE64
APPSTORE_CERTIFICATES_FILE_BASE64=COLE_AQUI_O_CERTIFICADO_P12_EM_BASE64
APPSTORE_CERTIFICATES_PASSWORD=COLE_AQUI_A_SENHA_DO_P12
